package settings

import (
	"whatsappconverty/internal/shops"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

// SettingsPage is the owner-only WhatsApp management page. The sending
// identity is the platform's shared number (read-only, configured in env);
// the owner manages the shop contact phone and can disable the service.
templ SettingsPage(page components.Page, shop shops.Shop, flash, platformNumber, verifiedName string) {
	@layouts.Shell(page) {
		<div class="mx-auto max-w-3xl">
			<h1 class="text-2xl font-bold text-slate-900">WhatsApp settings</h1>
			<p class="mt-1 text-sm text-slate-500">
				Notifications are sent from <span class="font-medium text-slate-700">{ platformNumber }</span> ({ verifiedName }),
				the platform's shared WhatsApp number. You never provide Meta credentials.
			</p>

			if fl := settingsFlash(flash); fl != "" {
				<div class={ "mt-4 rounded-lg border px-4 py-3 text-sm ", settingsFlashClass(flash) }>{ fl }</div>
			}

			<div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
				<div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
					<div class="flex items-center gap-3">
						if shop.WhatsappEnabled {
							<span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-700">
								<span class="h-2 w-2 rounded-full bg-emerald-500"></span> Enabled
							</span>
						} else {
							<span class="inline-flex items-center gap-2 rounded-full bg-amber-50 px-3 py-1 text-sm font-medium text-amber-700">
								<span class="h-2 w-2 rounded-full bg-amber-500"></span> Disabled
							</span>
						}
					</div>
					if shop.WhatsappEnabled {
						<form method="post" action="/settings/disable"
							onsubmit="return confirm('Disable WhatsApp sending for this shop? Automations will stop delivering until you enable it again.')">
							<button type="submit"
								class="rounded-lg border border-rose-200 px-3 py-1.5 text-sm font-medium text-rose-600 transition hover:bg-rose-50">
								Disable service
							</button>
						</form>
					} else {
						<a href="/whatsapp/onboard"
							class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
							Enable WhatsApp messaging
						</a>
					}
				</div>

				<dl class="grid grid-cols-1 gap-4 px-6 py-4 sm:grid-cols-2">
					<div>
						<dt class="text-xs font-medium uppercase tracking-wide text-slate-400">Sending number</dt>
						<dd class="mt-1 text-sm font-medium text-slate-900">{ platformNumber }</dd>
						<dd class="text-xs text-slate-500">{ verifiedName }</dd>
					</div>
					<div>
						<dt class="text-xs font-medium uppercase tracking-wide text-slate-400">Service</dt>
						<dd class="mt-1 text-sm font-medium text-slate-900">
							if shop.WhatsappEnabled {
								<span class="text-emerald-700">Active</span>
							} else {
								<span class="text-slate-500">Off</span>
							}
						</dd>
						if shop.WhatsappTermsAcceptedAt != nil {
							<dd class="text-xs text-slate-500">Terms accepted { shop.WhatsappTermsAcceptedAt.Format("2 Jan 2006") }</dd>
						}
					</div>
				</dl>

				<form method="post" action="/settings/phone" class="border-t border-slate-100 px-6 py-4">
					<label for="shop-phone" class="block text-xs font-medium uppercase tracking-wide text-slate-400">
						Shop contact phone
					</label>
					<div class="mt-2 flex max-w-md items-end gap-3">
						<input id="shop-phone" name="shop_phone" type="tel"
							value={ shop.Phone }
							placeholder="+21624118849"
							class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500"/>
						<button type="submit"
							class="shrink-0 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
							Save
						</button>
					</div>
					<p class="mt-2 text-xs text-slate-500">International format with country code. Shown on the WhatsApp status card.</p>
				</form>
			</div>

			if shop.WhatsappEnabled {
				<div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
					Sending is active. Automations deliver order notifications from the shared platform number.
				</div>
			}
		</div>
	}
}

func settingsFlash(kind string) string {
	if kind == "" {
		return ""
	}
	return settingsFlashText(kind)
}

func settingsFlashClass(kind string) string {
	switch kind {
	case "invalid_phone", "error":
		return "border-rose-200 bg-rose-50 text-rose-800"
	default:
		return "border-emerald-200 bg-emerald-50 text-emerald-800"
	}
}

func settingsFlashText(kind string) string {
	switch kind {
	case "phone_saved":
		return "Contact phone updated."
	case "disabled":
		return "WhatsApp service disabled. Automations will not deliver until you enable it again."
	case "invalid_phone":
		return "That phone number does not look valid. Use international format, e.g. +21624118849."
	default:
		return "Something went wrong. Please try again."
	}
}