package viewsadmin

import (
	"fmt"
	"strconv"

	"whatsappconverty/internal/admin"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

// Index renders the platform admin console overview: the WA Relay style
// dashboard (stats, volume, health, alerts, clients, live activity) on top of
// the live roster of client accounts and shops.
templ Index(page components.Page, o admin.Overview) {
	@layouts.Shell(page) {
		<div class="-m-4 min-h-[calc(100vh-4rem)] bg-relay-bg p-6 text-relay-fg sm:-m-6 sm:p-10">
			<header class="mb-8 flex flex-wrap items-center justify-between gap-4">
				<div>
					<h2 class="font-display text-3xl font-bold leading-tight">Overview</h2>
					<p class="text-sm text-relay-mutedfg">Last 30 days · sample data</p>
				</div>
				<div class="flex items-center gap-2 rounded-full border border-white/10 bg-relay-card px-4 py-2 text-sm">
					<span class="inline-block h-2 w-2 rounded-full bg-relay-primary"></span>
					+216 24 118 849 · Connected
				</div>
			</header>

			<!-- Stats row -->
			<div class="mb-4 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-5">
				for _, s := range sampleStats {
					<div class="rounded-xl border border-white/10 bg-relay-card p-5">
						<div class="flex items-center justify-between text-relay-mutedfg">
							<span class="text-xs">{ s.Label }</span>
							@statIcon(s.Icon)
						</div>
						<div class="mt-3 font-display text-2xl font-bold">{ s.Value }</div>
						<div class={ "text-xs ", deltaClass(s.Tone) }>{ s.Delta }</div>
					</div>
				}
			</div>

			<!-- Volume chart + number health -->
			<div class="mb-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
				<section class="rounded-xl border border-white/10 bg-relay-card p-5 lg:col-span-2">
					<h3 class="mb-4 font-display text-xs font-medium uppercase tracking-widest text-relay-mutedfg">Message volume</h3>
					<div class="flex h-44 items-end gap-2">
						for _, h := range sampleVolume {
							<div class="wa-bar flex-1 rounded-t" style={ fmt.Sprintf("height: %d%%", h) }></div>
						}
					</div>
				</section>
				<section class="rounded-xl border border-white/10 bg-relay-card p-5">
					<h3 class="mb-4 font-display text-xs font-medium uppercase tracking-widest text-relay-mutedfg">Number health</h3>
					<div class="text-sm">
						for _, r := range sampleHealth {
							<div class="flex items-center justify-between py-1.5">
								<span class="text-relay-mutedfg">{ r.Label }</span>
								<span class={ healthValueClass(r.Tone) }>{ r.Value }</span>
							</div>
						}
					</div>
					<div class="flex items-center gap-2 border-t border-white/10 pt-3 text-xs text-relay-mutedfg">
						<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a10 10 0 1 0-10-10c0 4.5 3 8.5 6.5 10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
						{ sampleHealthNote }
					</div>
				</section>
			</div>

			<!-- Alerts + clients -->
			<div class="mb-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
				<section class="rounded-xl border border-white/10 bg-relay-card p-5">
					<h3 class="mb-4 font-display text-xs font-medium uppercase tracking-widest text-relay-mutedfg">Alerts</h3>
					<ul class="flex flex-col gap-3 text-sm">
						for _, a := range sampleAlerts {
							<li class="flex gap-2">
								@alertIcon(a.Severity)
								<span>{ a.Text }</span>
							</li>
						}
					</ul>
				</section>
				<section class="rounded-xl border border-white/10 bg-relay-card p-5 lg:col-span-2">
					<h3 class="mb-4 font-display text-xs font-medium uppercase tracking-widest text-relay-mutedfg">Clients</h3>
					<div class="overflow-x-auto">
						<table class="w-full text-left text-sm">
							<thead>
								<tr class="text-xs font-medium text-relay-mutedfg">
									<th class="pb-2 pr-2">Client</th>
									<th class="pb-2 pr-2">Plan</th>
									<th class="pb-2 pr-2">Quota</th>
									<th class="pb-2 pr-2">Delivery</th>
									<th class="pb-2">Status</th>
								</tr>
							</thead>
							<tbody>
								for _, c := range sampleClients {
									<tr class="border-t border-white/10">
										<td class="py-2.5 pr-2 font-medium">{ c.Name }</td>
										<td class="py-2.5 pr-2 text-relay-mutedfg">{ c.Plan }</td>
										<td class="py-2.5 pr-2">
											<div class="h-1.5 w-24 overflow-hidden rounded-full bg-relay-muted">
												<div class="h-full rounded-full bg-relay-primary" style={ fmt.Sprintf("width: %d%%", c.QuotaPct) }></div>
											</div>
										</td>
										<td class="py-2.5 pr-2">{ c.Delivery }</td>
										<td class="py-2.5">@relayBadge(c.StatusTone, c.Status)</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</section>
			</div>

			<!-- Live activity -->
			<section class="rounded-xl border border-white/10 bg-relay-card p-5">
				<h3 class="mb-4 font-display text-xs font-medium uppercase tracking-widest text-relay-mutedfg">Live activity</h3>
				<ul class="text-sm">
					for i, f := range sampleFeed {
						<li class={ "flex items-center gap-4 py-2.5 ", feedBorder(i) }>
							<span class="w-12 text-relay-mutedfg">{ f.Time }</span>
							<span class="w-28 font-medium">{ f.Client }</span>
							<span class="min-w-0 flex-1 truncate text-relay-mutedfg">{ f.Message }</span>
							@relayBadge(f.StatusTone, f.Status)
						</li>
					}
				</ul>
			</section>

			<!-- Live roster -->
			<section class="mt-12">
				<h3 class="mb-3 font-display text-lg font-semibold">Client accounts</h3>
				<p class="mb-4 text-sm text-relay-mutedfg">Every client account on the platform.</p>
				if len(o.Clients) == 0 {
					<p class="text-sm text-relay-mutedfg">No clients yet. Client accounts appear here once merchants register.</p>
				} else {
					<div class="overflow-x-auto rounded-xl border border-white/10 bg-relay-card">
						<table class="min-w-full text-sm">
							<thead>
								<tr class="text-left text-xs font-medium uppercase tracking-wide text-relay-mutedfg">
									<th class="px-4 py-3">Client</th>
									<th class="px-4 py-3">Status</th>
									<th class="px-4 py-3">Shops</th>
									<th class="px-4 py-3">WhatsApp</th>
									<th class="px-4 py-3">Joined</th>
								</tr>
							</thead>
							<tbody>
								for _, c := range o.Clients {
									<tr class="border-t border-white/10">
										<td class="px-4 py-3">
											<div class="font-medium">{ c.Name }</div>
											<div class="text-relay-mutedfg">{ c.Email }</div>
										</td>
										<td class="px-4 py-3">
											@relayBadge(statusTone(c.Status), c.Status)
										</td>
										<td class="px-4 py-3">
											if c.ShopNames != "" {
												{ c.ShopNames }
											} else {
												<span class="text-relay-mutedfg">—</span>
											}
										</td>
										<td class="px-4 py-3">
											if c.Whatsapp {
												<span class="inline-flex items-center gap-1.5 text-relay-primary"><span class="h-2 w-2 rounded-full bg-relay-primary"></span> Enabled</span>
											} else {
												<span class="inline-flex items-center gap-1.5 text-relay-mutedfg"><span class="h-2 w-2 rounded-full bg-relay-muted"></span> Off</span>
											}
										</td>
										<td class="px-4 py-3 text-relay-mutedfg">{ c.CreatedAt.Format("2006-01-02") }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>

			<section class="mt-12">
				<h3 class="mb-3 font-display text-lg font-semibold">Shops</h3>
				<p class="mb-4 text-sm text-relay-mutedfg">Every shop registered by a client.</p>
				if len(o.Shops) == 0 {
					<p class="text-sm text-relay-mutedfg">No shops yet. Shops appear here once a client registers one.</p>
				} else {
					<div class="overflow-x-auto rounded-xl border border-white/10 bg-relay-card">
						<table class="min-w-full text-sm">
							<thead>
								<tr class="text-left text-xs font-medium uppercase tracking-wide text-relay-mutedfg">
									<th class="px-4 py-3">Shop</th>
									<th class="px-4 py-3">Owner</th>
									<th class="px-4 py-3">Phone</th>
									<th class="px-4 py-3">WhatsApp</th>
									<th class="px-4 py-3">Templates</th>
								</tr>
							</thead>
							<tbody>
								for _, s := range o.Shops {
									<tr class="border-t border-white/10">
										<td class="px-4 py-3 font-medium">{ s.Name }</td>
										<td class="px-4 py-3">
											<div>{ s.ClientName }</div>
											<div class="text-relay-mutedfg">{ s.ClientEmail }</div>
										</td>
										<td class="px-4 py-3">
											if s.Phone != "" {
												{ s.Phone }
											} else {
												<span class="text-relay-mutedfg">—</span>
											}
										</td>
										<td class="px-4 py-3">
											if s.WhatsappEnabled {
												<span class="inline-flex items-center gap-1.5 text-relay-primary"><span class="h-2 w-2 rounded-full bg-relay-primary"></span> Enabled</span>
											} else {
												<span class="inline-flex items-center gap-1.5 text-relay-mutedfg"><span class="h-2 w-2 rounded-full bg-relay-muted"></span> Off</span>
											}
										</td>
										<td class="px-4 py-3">{ strconv.Itoa(s.TemplateCount) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>
		</div>
	}
}

templ statIcon(name string) {
	<svg class="h-4 w-4 text-relay-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		if name == "send" {
			<path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
		} else if name == "check-circle" {
			<path d="M7 12.5 10.5 16 17 9"/><circle cx="12" cy="12" r="10"/>
		} else if name == "x-circle" {
			<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>
		} else if name == "users" {
			<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
		} else {
			<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>
		}
	</svg>
}

templ alertIcon(severity string) {
	<svg class={ "mt-0.5 h-4 w-4 flex-shrink-0 ", alertIconClass(severity) } xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
}

templ relayBadge(tone string, label string) {
	<span class={ "wa-badge ", badgeClass(tone) }>{ label }</span>
}

func badgeClass(tone string) string {
	switch tone {
	case "success":
		return "wa-badge-success"
	case "warning":
		return "wa-badge-warning"
	case "danger":
		return "wa-badge-danger"
	case "primary":
		return "wa-badge-primary"
	default:
		return "wa-badge-muted"
	}
}

func alertIconClass(severity string) string {
	if severity == "danger" {
		return "text-relay-danger"
	}
	return "text-relay-warning"
}

func deltaClass(tone string) string {
	if tone == "bad" {
		return "text-relay-danger"
	}
	return "text-relay-primary"
}

func healthValueClass(tone string) string {
	switch tone {
	case "success":
		return "font-medium text-relay-primary"
	case "warning":
		return "font-medium text-relay-warning"
	default:
		return "font-medium text-relay-fg"
	}
}

func feedBorder(i int) string {
	if i == 0 {
		return ""
	}
	return "border-t border-white/10"
}

func statusTone(status string) string {
	switch status {
	case "active":
		return "success"
	case "pending":
		return "warning"
	case "suspended":
		return "danger"
	default:
		return "muted"
	}
}
