package viewsadmin

import (
	"fmt"
	"strconv"

	"whatsappconverty/internal/admin"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

// Index renders the platform admin console overview: the WA Relay style
// dashboard (stats, volume, health, alerts, clients, live activity) on top of
// the live roster of client accounts and shops. Every figure is a real
// platform aggregate; where nothing is tracked yet the value renders as "—".
templ Index(page components.Page, o admin.Overview) {
	@layouts.Shell(page) {
		<div class="-m-4 min-h-[calc(100vh-4rem)] bg-relay-bg p-6 text-relay-fg sm:-m-6 sm:p-10">
			<header class="mb-8 flex flex-wrap items-center justify-between gap-4">
				<div>
					<h2 class="font-display text-3xl font-bold leading-tight">Overview</h2>
					<p class="text-sm text-relay-mutedfg">Last 30 days</p>
				</div>
				<div class="flex items-center gap-2 rounded-full border border-white/10 bg-relay-card px-4 py-2 text-sm">
					<span class="inline-block h-2 w-2 rounded-full bg-relay-primary"></span>
					+216 24 118 849 · Connected
				</div>
			</header>

			<!-- Stats row -->
			<div class="mb-4 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-5">
				@statCard("Messages sent", strconv.Itoa(o.Metrics.Sent30d), deltaPct(o.Metrics.Sent30d, o.Metrics.SentPrev30d, true), "send")
				@statCard("Delivery rate", deliveryRateValue(o.Metrics), deliveryRateDelta(o.Metrics), "check-circle")
				@statCard("Failed", strconv.Itoa(o.Metrics.Failed30d), deltaPct(o.Metrics.Failed30d, o.Metrics.FailedPrev30d, false), "x-circle")
				@statCard("Active clients", strconv.Itoa(o.Summary.ActiveClients), deltaCount(o.Metrics.NewActiveClients), "users")
				@statCard("Revenue (30d)", dollars(o.Metrics.RevenueUSD()), deltaPct64(o.Metrics.RevenueMicros, o.Metrics.RevenuePrev, true), "revenue")
			</div>

			<!-- Volume chart + number health -->
			<div class="mb-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
				<section class="rounded-xl border border-white/10 bg-relay-card p-5 lg:col-span-2">
					<h3 class="mb-4 font-display text-xs font-medium uppercase tracking-widest text-relay-mutedfg">Message volume · 14 days</h3>
					if o.Metrics.VolumeMax == 0 {
						<div class="flex h-44 items-center justify-center text-sm text-relay-mutedfg">No messages in the last 14 days</div>
					} else {
						<div class="flex h-44 items-end gap-2">
							for _, h := range o.Metrics.Volume {
								<div class="wa-bar flex-1 rounded-t" style={ fmt.Sprintf("height: %d%%", barHeight(h, o.Metrics.VolumeMax)) }></div>
							}
						</div>
					}
				</section>
				<section class="rounded-xl border border-white/10 bg-relay-card p-5">
					<h3 class="mb-4 font-display text-xs font-medium uppercase tracking-widest text-relay-mutedfg">Number health</h3>
					<div class="text-sm">
						@healthRow("Quality rating", "—", "")
						@healthRow("Messaging tier", "—", "")
						@healthRow("Block rate", "—", "")
						@healthRow("Queue", queueValue(o.Metrics.QueuePending), queueTone(o.Metrics.QueuePending))
					</div>
					<div class="flex items-center gap-2 border-t border-white/10 pt-3 text-xs text-relay-mutedfg">
						<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a10 10 0 1 0-10-10c0 4.5 3 8.5 6.5 10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
						{ fmt.Sprintf("Messages sent today: %d", o.Metrics.SentToday) }
					</div>
				</section>
			</div>

			<!-- Alerts + clients -->
			<div class="mb-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
				<section class="rounded-xl border border-white/10 bg-relay-card p-5">
					<h3 class="mb-4 font-display text-xs font-medium uppercase tracking-widest text-relay-mutedfg">Alerts</h3>
					if len(o.Metrics.Alerts) == 0 {
						<p class="text-sm text-relay-mutedfg">No alerts right now.</p>
					} else {
						<ul class="flex flex-col gap-3 text-sm">
							for _, a := range o.Metrics.Alerts {
								<li class="flex gap-2">
									@alertIcon(a.Severity)
									<span>{ a.Text }</span>
								</li>
							}
						</ul>
					}
				</section>
				<section class="rounded-xl border border-white/10 bg-relay-card p-5 lg:col-span-2">
					<h3 class="mb-4 font-display text-xs font-medium uppercase tracking-widest text-relay-mutedfg">Clients</h3>
					if len(o.Clients) == 0 {
						<p class="text-sm text-relay-mutedfg">No clients yet. Client accounts appear here once merchants register.</p>
					} else {
						<div class="overflow-x-auto">
							<table class="w-full text-left text-sm">
								<thead>
									<tr class="text-xs font-medium text-relay-mutedfg">
										<th class="pb-2 pr-3">Client</th>
										<th class="pb-2 pr-3">Status</th>
										<th class="pb-2 pr-3">Shops</th>
										<th class="pb-2 pr-3">Usage (30d)</th>
										<th class="pb-2 pr-3">Delivery</th>
										<th class="pb-2 pr-3">Credit</th>
										<th class="pb-2">Joined</th>
									</tr>
								</thead>
								<tbody>
									for _, c := range o.Clients {
										<tr class="border-t border-white/10">
											<td class="py-2.5 pr-3">
												<div class="font-medium">{ c.Name }</div>
												<div class="text-relay-mutedfg">{ c.Email }</div>
											</td>
											<td class="py-2.5 pr-3">@relayBadge(statusTone(c.Status), c.Status)</td>
											<td class="py-2.5 pr-3">{ strconv.Itoa(c.ShopCount) }</td>
											<td class="py-2.5 pr-3">
												<div class="flex items-center gap-2">
													<div class="h-1.5 w-20 overflow-hidden rounded-full bg-relay-muted">
														<div class="h-full rounded-full bg-relay-primary" style={ fmt.Sprintf("width: %d%%", usagePercent(c.Sent30d, maxClientSent(o.Clients))) }></div>
													</div>
													<span class="text-xs text-relay-mutedfg">{ strconv.Itoa(c.Sent30d) }</span>
												</div>
											</td>
											<td class="py-2.5 pr-3">{ deliveryValue(c) }</td>
											<td class="py-2.5 pr-3">{ creditValue(c) }</td>
											<td class="py-2.5 text-relay-mutedfg">{ c.CreatedAt.Format("2006-01-02") }</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</section>
			</div>

			<!-- Live activity -->
			<section class="rounded-xl border border-white/10 bg-relay-card p-5">
				<h3 class="mb-4 font-display text-xs font-medium uppercase tracking-widest text-relay-mutedfg">Live activity</h3>
				if len(o.Metrics.Activity) == 0 {
					<p class="text-sm text-relay-mutedfg">No messages yet.</p>
				} else {
					<ul class="text-sm">
						for i, a := range o.Metrics.Activity {
							<li class={ "flex items-center gap-4 py-2.5 ", feedBorder(i) }>
								<span class="w-12 text-relay-mutedfg">{ a.Time }</span>
								<span class="w-28 truncate font-medium">{ a.Client }</span>
								<span class="min-w-0 flex-1 truncate text-relay-mutedfg">{ a.Message }</span>
								@relayBadge(messageTone(a.Status), a.Status)
							</li>
						}
					</ul>
				}
			</section>

			<!-- Live roster -->
			<section class="mt-12">
				<h3 class="mb-3 font-display text-lg font-semibold">Shops</h3>
				<p class="mb-4 text-sm text-relay-mutedfg">Every shop registered by a client.</p>
				if len(o.Shops) == 0 {
					<p class="text-sm text-relay-mutedfg">No shops yet. Shops appear here once a client registers one.</p>
				} else {
					<div class="overflow-x-auto rounded-xl border border-white/10 bg-relay-card">
						<table class="min-w-full text-sm">
							<thead>
								<tr class="text-left text-xs font-medium uppercase tracking-wide text-relay-mutedfg">
									<th class="px-4 py-3">Shop</th>
									<th class="px-4 py-3">Owner</th>
									<th class="px-4 py-3">Phone</th>
									<th class="px-4 py-3">WhatsApp</th>
									<th class="px-4 py-3">Templates</th>
								</tr>
							</thead>
							<tbody>
								for _, s := range o.Shops {
									<tr class="border-t border-white/10">
										<td class="px-4 py-3 font-medium">{ s.Name }</td>
										<td class="px-4 py-3">
											<div>{ s.ClientName }</div>
											<div class="text-relay-mutedfg">{ s.ClientEmail }</div>
										</td>
										<td class="px-4 py-3">
											if s.Phone != "" {
												{ s.Phone }
											} else {
												<span class="text-relay-mutedfg">—</span>
											}
										</td>
										<td class="px-4 py-3">
											if s.WhatsappEnabled {
												<span class="inline-flex items-center gap-1.5 text-relay-primary"><span class="h-2 w-2 rounded-full bg-relay-primary"></span> Enabled</span>
											} else {
												<span class="inline-flex items-center gap-1.5 text-relay-mutedfg"><span class="h-2 w-2 rounded-full bg-relay-muted"></span> Off</span>
											}
										</td>
										<td class="px-4 py-3">{ strconv.Itoa(s.TemplateCount) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>
		</div>
	}
}

templ statCard(label string, value string, delta deltaText, icon string) {
	<div class="rounded-xl border border-white/10 bg-relay-card p-5">
		<div class="flex items-center justify-between text-relay-mutedfg">
			<span class="text-xs">{ label }</span>
			@statIcon(icon)
		</div>
		<div class="mt-3 font-display text-2xl font-bold">{ value }</div>
		<div class={ "text-xs ", deltaClass(delta.tone) }>{ delta.text }</div>
	</div>
}

templ healthRow(label, value, tone string) {
	<div class="flex items-center justify-between py-1.5">
		<span class="text-relay-mutedfg">{ label }</span>
		<span class={ healthValueClass(tone) }>{ value }</span>
	</div>
}

// deltaText is a formatted stat delta plus its tone: "good", "bad" or "" when
// there is no baseline to compare against.
type deltaText struct {
	text string
	tone string
}

templ statIcon(name string) {
	<svg class="h-4 w-4 text-relay-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		if name == "send" {
			<path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
		} else if name == "check-circle" {
			<path d="M7 12.5 10.5 16 17 9"/><circle cx="12" cy="12" r="10"/>
		} else if name == "x-circle" {
			<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>
		} else if name == "users" {
			<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
		} else {
			<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>
		}
	</svg>
}

templ alertIcon(severity string) {
	<svg class={ "mt-0.5 h-4 w-4 flex-shrink-0 ", alertIconClass(severity) } xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
}

templ relayBadge(tone string, label string) {
	<span class={ "wa-badge ", badgeClass(tone) }>{ label }</span>
}

func badgeClass(tone string) string {
	switch tone {
	case "success":
		return "wa-badge-success"
	case "warning":
		return "wa-badge-warning"
	case "danger":
		return "wa-badge-danger"
	case "primary":
		return "wa-badge-primary"
	default:
		return "wa-badge-muted"
	}
}

func alertIconClass(severity string) string {
	if severity == "danger" {
		return "text-relay-danger"
	}
	return "text-relay-warning"
}

func deltaClass(tone string) string {
	switch tone {
	case "bad":
		return "text-relay-danger"
	case "good":
		return "text-relay-primary"
	default:
		return "text-relay-mutedfg"
	}
}

func healthValueClass(tone string) string {
	switch tone {
	case "success":
		return "font-medium text-relay-primary"
	case "warning":
		return "font-medium text-relay-warning"
	default:
		return "font-medium text-relay-fg"
	}
}

func feedBorder(i int) string {
	if i == 0 {
		return ""
	}
	return "border-t border-white/10"
}

func statusTone(status string) string {
	switch status {
	case "active":
		return "success"
	case "pending":
		return "warning"
	case "suspended":
		return "danger"
	default:
		return "muted"
	}
}

// messageTone maps a message status to a badge tone.
func messageTone(status string) string {
	switch status {
	case "read":
		return "success"
	case "delivered":
		return "primary"
	case "failed":
		return "danger"
	default:
		return "muted"
	}
}

// deltaPct formats the percent change between two counts. When prev is zero
// there is no baseline, so it returns a muted em dash.
func deltaPct(cur, prev int, upIsGood bool) deltaText {
	if prev == 0 {
		return deltaText{text: "—"}
	}
	pct := float64(cur-prev) / float64(prev) * 100
	return signedDelta(pct, cur >= prev, upIsGood)
}

func deltaPct64(cur, prev int64, upIsGood bool) deltaText {
	if prev == 0 {
		return deltaText{text: "—"}
	}
	pct := float64(cur-prev) / float64(prev) * 100
	return signedDelta(pct, cur >= prev, upIsGood)
}

func signedDelta(pct float64, up bool, upIsGood bool) deltaText {
	sign := "+"
	if pct < 0 {
		sign = ""
	}
	tone := "good"
	if up != upIsGood {
		tone = "bad"
	}
	return deltaText{text: fmt.Sprintf("%s%.1f%%", sign, pct), tone: tone}
}

// deltaCount shows the number of new clients, or a muted em dash when there
// are none in the window.
func deltaCount(n int) deltaText {
	if n == 0 {
		return deltaText{text: "—"}
	}
	return deltaText{text: fmt.Sprintf("+%d new", n), tone: "good"}
}

func deliveryRateValue(m admin.Metrics) string {
	rate, ok := m.DeliveryRate()
	if !ok {
		return "—"
	}
	return fmt.Sprintf("%.1f%%", rate*100)
}

func deliveryRateDelta(m admin.Metrics) deltaText {
	cur, ok := m.DeliveryRate()
	if !ok {
		return deltaText{text: "—"}
	}
	prev, prevOK := m.DeliveryRatePrev()
	if !prevOK {
		return deltaText{text: "—"}
	}
	pp := (cur - prev) * 100
	return signedDelta(pp, pp >= 0, true)
}

func deliveryValue(c admin.Client) string {
	if !c.HasDelivery {
		return "—"
	}
	return fmt.Sprintf("%.1f%%", c.DeliveryRate*100)
}

func creditValue(c admin.Client) string {
	if !c.HasCredit {
		return "—"
	}
	return dollars(float64(c.BalanceMicros) / 1e6)
}

func dollars(v float64) string {
	return fmt.Sprintf("$%.2f", v)
}

func queueValue(n int) string {
	return fmt.Sprintf("%d pending", n)
}

func queueTone(n int) string {
	if n > 0 {
		return "warning"
	}
	return ""
}

// maxClientSent is the largest per-client 30-day send count, used to scale the
// usage bars.
func maxClientSent(clients []admin.Client) int {
	max := 0
	for _, c := range clients {
		if c.Sent30d > max {
			max = c.Sent30d
		}
	}
	return max
}

func usagePercent(sent, max int) int {
	if max <= 0 {
		return 0
	}
	return int(float64(sent) / float64(max) * 100)
}

func barHeight(count, max int) int {
	if max <= 0 {
		return 0
	}
	h := int(float64(count) / float64(max) * 100)
	if h < 4 && count > 0 {
		h = 4
	}
	return h
}
