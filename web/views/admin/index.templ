package viewsadmin

import (
	"strconv"

	"whatsappconverty/internal/admin"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

// Index renders the platform admin console: headline counts plus the roster of
// client accounts and their shops.
templ Index(page components.Page, o admin.Overview) {
	@layouts.Shell(page) {
		<div class="mb-6">
			<h2 class="text-xl font-semibold text-slate-900">Platform overview</h2>
			<p class="text-sm text-slate-500">Every client account and shop on the platform.</p>
		</div>

		<div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			@components.StatCard("Clients", strconv.Itoa(o.Summary.Clients), strconv.Itoa(o.Summary.ActiveClients)+" active")
			@components.StatCard("Shops", strconv.Itoa(o.Summary.Shops), "total")
			@components.StatCard("WhatsApp enabled", strconv.Itoa(o.Summary.WhatsappShops), "shops")
		</div>

		<section class="mb-8">
			<h3 class="mb-3 text-lg font-semibold text-slate-900">Clients</h3>
			if len(o.Clients) == 0 {
				@components.EmptyState("No clients yet", "Client accounts appear here once merchants register.")
			} else {
				<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
					<table class="min-w-full divide-y divide-slate-200 text-sm">
						<thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
							<tr>
								<th class="px-4 py-3">Client</th>
								<th class="px-4 py-3">Status</th>
								<th class="px-4 py-3">Shops</th>
								<th class="px-4 py-3">WhatsApp</th>
								<th class="px-4 py-3">Joined</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							for _, c := range o.Clients {
								<tr>
									<td class="px-4 py-3">
										<div class="font-medium text-slate-900">{ c.Name }</div>
										<div class="text-slate-500">{ c.Email }</div>
									</td>
									<td class="px-4 py-3">
										<span class={ "inline-flex rounded-full px-2 py-0.5 text-xs font-medium ", statusClass(c.Status) }>{ c.Status }</span>
									</td>
									<td class="px-4 py-3 text-slate-700">
										if c.ShopNames != "" {
											{ c.ShopNames }
										} else {
											<span class="text-slate-400">—</span>
										}
									</td>
									<td class="px-4 py-3">
										if c.Whatsapp {
											<span class="inline-flex items-center gap-1.5 text-emerald-700"><span class="h-2 w-2 rounded-full bg-emerald-500"></span> Enabled</span>
										} else {
											<span class="inline-flex items-center gap-1.5 text-slate-400"><span class="h-2 w-2 rounded-full bg-slate-300"></span> Off</span>
										}
									</td>
									<td class="px-4 py-3 text-slate-500">{ c.CreatedAt.Format("2006-01-02") }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>

		<section>
			<h3 class="mb-3 text-lg font-semibold text-slate-900">Shops</h3>
			if len(o.Shops) == 0 {
				@components.EmptyState("No shops yet", "Shops appear here once a client registers one.")
			} else {
				<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
					<table class="min-w-full divide-y divide-slate-200 text-sm">
						<thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
							<tr>
								<th class="px-4 py-3">Shop</th>
								<th class="px-4 py-3">Owner</th>
								<th class="px-4 py-3">Phone</th>
								<th class="px-4 py-3">WhatsApp</th>
								<th class="px-4 py-3">Templates</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							for _, s := range o.Shops {
								<tr>
									<td class="px-4 py-3 font-medium text-slate-900">{ s.Name }</td>
									<td class="px-4 py-3 text-slate-700">
										<div>{ s.ClientName }</div>
										<div class="text-slate-500">{ s.ClientEmail }</div>
									</td>
									<td class="px-4 py-3 text-slate-700">
										if s.Phone != "" {
											{ s.Phone }
										} else {
											<span class="text-slate-400">—</span>
										}
									</td>
									<td class="px-4 py-3">
										if s.WhatsappEnabled {
											<span class="inline-flex items-center gap-1.5 text-emerald-700"><span class="h-2 w-2 rounded-full bg-emerald-500"></span> Enabled</span>
										} else {
											<span class="inline-flex items-center gap-1.5 text-slate-400"><span class="h-2 w-2 rounded-full bg-slate-300"></span> Off</span>
										}
									</td>
									<td class="px-4 py-3 text-slate-700">{ strconv.Itoa(s.TemplateCount) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}

func statusClass(status string) string {
	switch status {
	case "active":
		return "bg-emerald-50 text-emerald-700"
	case "pending":
		return "bg-amber-50 text-amber-700"
	case "suspended":
		return "bg-rose-50 text-red-700"
	default:
		return "bg-slate-100 text-slate-600"
	}
}
