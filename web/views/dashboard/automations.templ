package viewsdashboard

import (
	"fmt"
	"strings"

	"github.com/google/uuid"

	"whatsappconverty/internal/automations"
	"whatsappconverty/internal/whatsapp"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

type AutomationFlash struct {
	Error string
	Info  string
}

func typeLabel(a automations.Automation) string {
	if a.DelayMinutes != nil {
		return "Delayed"
	}
	if a.SendTime != nil {
		return "Scheduled"
	}
	return "Instant"
}

func typeDetail(a automations.Automation) string {
	if a.DelayMinutes != nil {
		return fmt.Sprintf("%d min after the event", *a.DelayMinutes)
	}
	if a.SendTime != nil {
		tz := a.SendTimezone
		if tz == "" {
			tz = "UTC"
		}
		return fmt.Sprintf("%02d:%02d · %s", a.SendTime.Hour(), a.SendTime.Minute(), tz)
	}
	return ""
}

var dayNames = [7]string{"Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"}

func daysLabel(days []int) string {
	if len(days) == 0 {
		return "All days"
	}
	if len(days) == 7 {
		return "All days"
	}
	var parts []string
	for _, d := range days {
		if d >= 1 && d <= 7 {
			parts = append(parts, dayNames[d-1])
		}
	}
	return strings.Join(parts, ", ")
}

templ automationCardBody(a automations.Automation, templateNames map[uuid.UUID]string, templateBodies map[uuid.UUID]string) {
	<div class="p-5">
		<div class="flex items-start justify-between gap-4">
			<div>
				<div class="flex items-center gap-2">
					<span class="text-base font-bold text-slate-900">{ a.Name }</span>
					if a.Enabled {
						<span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">Active</span>
					} else {
						<span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">Paused</span>
					}
				</div>
				if a.Description != "" {
					<div class="mt-1 text-sm text-slate-500">{ a.Description }</div>
				}
			</div>
			<div class="flex items-center gap-2">
				<form method="post" action={ templ.SafeURL("/automations/" + a.ID.String() + "/toggle") }
					onsubmit="return true">
					if a.Enabled {
						<input type="hidden" name="enabled" value="0" />
						<button type="submit"
							class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50">Pause</button>
					} else {
						<input type="hidden" name="enabled" value="1" />
						<button type="submit"
							class="rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-sm font-medium text-indigo-700 transition hover:bg-indigo-100">Enable</button>
					}
				</form>
				<a href={ templ.SafeURL("/automations/" + a.ID.String() + "/history") }
					class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50">History</a>
				<a href={ templ.SafeURL("/automations/" + a.ID.String() + "/edit") }
					class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50">Edit</a>
				if a.TemplateID != uuid.Nil {
					<button type="button" @click="testOpen = true"
						class="rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-sm font-medium text-emerald-700 transition hover:bg-emerald-100">Test</button>
				}
				<form method="post" action={ templ.SafeURL("/automations/" + a.ID.String() + "/delete") }
					onsubmit="return confirm('Delete this automation?')">
					<button type="submit"
						class="rounded-lg px-3 py-1.5 text-sm font-medium text-rose-600 transition hover:bg-rose-50">Delete</button>
				</form>
			</div>
		</div>

		<div class="mt-4 grid grid-cols-2 gap-4 border-y border-slate-100 py-3 lg:grid-cols-4">
			<div>
				<div class="text-xs font-medium uppercase tracking-wide text-slate-400">Type</div>
				<div class="mt-1 text-sm font-medium text-slate-700">{ typeLabel(a) }</div>
				if a.SendTime != nil && len(a.SendDays) > 0 {
					<div class="text-xs text-slate-400">{ daysLabel(a.SendDays) }</div>
				}
				<div class="text-xs text-slate-400">{ typeDetail(a) }</div>
			</div>
			<div>
				<div class="text-xs font-medium uppercase tracking-wide text-slate-400">Trigger</div>
				<div class="mt-1">
					<span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700">{ automations.SourceLabel(a.EventSource) }</span>
				</div>
				<div class="mt-1 text-sm font-semibold text-slate-900">{ a.OrderStatus }</div>
			</div>
			<div>
				<div class="text-xs font-medium uppercase tracking-wide text-slate-400">Template</div>
				if a.TemplateID == uuid.Nil {
					<div class="mt-1">
						<span class="inline-flex items-center rounded-full bg-rose-50 px-2 py-0.5 text-xs font-medium text-rose-600">Deleted</span>
					</div>
				} else {
					<div class="mt-1">
						<span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">Approved</span>
					</div>
					<div class="mt-1 text-sm font-medium text-slate-900">{ templateNames[a.TemplateID] }</div>
				}
			</div>
			<div>
				<div class="text-xs font-medium uppercase tracking-wide text-slate-400">Message</div>
				<div class="mt-1 truncate text-sm text-slate-500">{ templateBodies[a.TemplateID] }</div>
			</div>
		</div>
	</div>

	if a.TemplateID != uuid.Nil {
		<div x-show="testOpen" x-cloak @keydown.escape.window="testOpen = false"
			class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60"
			@click.self="testOpen = false"
			x-transition.opacity>
			<div class="flex min-h-full items-start justify-center p-4">
				<div class="w-full max-w-md rounded-xl bg-white p-6 shadow-xl">
				<div class="flex items-start justify-between gap-4">
					<div>
						<h4 class="text-base font-semibold text-slate-900">Test message</h4>
						<p class="mt-1 text-sm text-slate-500">
							Template: <span class="font-medium text-slate-700">{ templateNames[a.TemplateID] }</span>
						</p>
					</div>
					<button type="button" @click="testOpen = false"
						class="rounded-lg p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600">
						<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>

				<form method="post" action={ templ.SafeURL("/automations/" + a.ID.String() + "/test") }
					class="mt-4">
					<label class="block text-xs font-medium text-slate-600">WhatsApp number</label>
					<input name="phone" type="tel" required inputmode="tel"
						placeholder="e.g. +21624118849"
						class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" />
					<p class="mt-1 text-xs text-slate-400">
						Use international format. The recipient must be in your WhatsApp test phone list
						or have an open 24h conversation.
					</p>

					<div class="mt-4 flex items-center justify-end gap-2">
						<button type="button" @click="testOpen = false"
							class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-50">Cancel</button>
						<button type="submit"
							class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-emerald-700">
							Send test message
						</button>
					</div>
				</form>
				</div>
			</div>
		</div>
	}
}

templ AutomationsPage(page components.Page, list []automations.Automation, templates []whatsapp.MerchantTemplate, templateNames map[uuid.UUID]string, templateBodies map[uuid.UUID]string, flash AutomationFlash) {
	@layouts.Shell(page) {
		<div class="space-y-6">
			<div class="flex items-center justify-between gap-4">
				<div>
					<h2 class="text-2xl font-bold text-slate-900">Automations</h2>
					<p class="mt-1 text-sm text-slate-500">
						Each automation sends an approved template when an order event happens —
						instant, at a fixed time, or after a delay.
					</p>
				</div>
				<a href="/automations/new"
					class="inline-flex shrink-0 items-center gap-2 rounded-lg border border-amber-300 bg-amber-100 px-4 py-2 text-sm font-semibold text-amber-900 transition hover:bg-amber-200">
					New automation
				</a>
			</div>

			if flash.Error != "" {
				<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{ flash.Error }</div>
			}
			if flash.Info != "" {
				<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">{ flash.Info }</div>
			}

			if len(list) == 0 {
				<div class="rounded-xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
					<div class="text-sm font-semibold text-slate-700">No automations yet</div>
					<div class="mt-1 text-sm text-slate-500">
						Create the first one — for example a "delivered" event that sends your
						order_delivered template at 10:00.
					</div>
					<a href="/automations/new"
						class="mt-4 inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
						Create an automation
					</a>
				</div>
			} else {
				for _, a := range list {
					<div class={ templ.SafeClass(borderClass(a.Enabled)) } x-data="{ testOpen: false }">
						@automationCardBody(a, templateNames, templateBodies)
					</div>
				}
			}
		</div>
	}
}

func borderClass(enabled bool) string {
	if enabled {
		return "rounded-xl border border-slate-200 border-l-4 border-l-emerald-500 bg-white shadow-sm"
	}
	return "rounded-xl border border-slate-200 border-l-4 border-l-slate-300 bg-white shadow-sm"
}