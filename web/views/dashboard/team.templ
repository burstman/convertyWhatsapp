package viewsdashboard

import (
	"whatsappconverty/internal/auth"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

type TeamInviteValues struct {
	Name  string `form:"name"`
	Email string `form:"email"`
}

type TeamFlash struct {
	Info        string
	Error       string
	InviteToken string
	InviteEmail string
}

// TeamPage is the owner-only member management page: it lists the shop's
// users and lets the owner invite (or remove) members. Clients invited here
// are granted the 'member' role, which keeps WhatsApp settings, billing and
// team management out of their reach.
templ TeamPage(page components.Page, baseURL string, members []auth.TeamMember, flash TeamFlash) {
	@layouts.Shell(page) {
		<div class="mx-auto max-w-3xl">
			<h1 class="text-2xl font-bold text-slate-900">Team</h1>
			<p class="mt-1 text-sm text-slate-500">
				Invite colleagues to manage the shop. Members can connect stores, build automations and create
				templates, but only the owner can change WhatsApp settings, billing and team.
			</p>

			if flash.Error != "" {
				<div class="mt-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">{ flash.Error }</div>
			}
			if flash.Info != "" {
				<div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">{ flash.Info }</div>
			}
			if flash.InviteToken != "" {
				<div class="mt-4 rounded-xl border border-indigo-200 bg-indigo-50 p-4" x-data="{ copied: false }">
					<p class="text-sm font-medium text-indigo-900">
						Invitation ready — send this one-time link to { flash.InviteEmail }
					</p>
					<p class="mt-1 text-xs text-indigo-600">Single use, expires in 7 days. Only this link can activate the account.</p>
					<div class="mt-3 flex items-end gap-3">
						<input x-ref="inviteLink" readonly value={ inviteURL(baseURL, flash.InviteToken) }
							class="block w-full rounded-lg border border-indigo-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"/>
						<button type="button" @click="navigator.clipboard.writeText($refs.inviteLink.value); copied = true"
							class="shrink-0 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
							<span x-show="!copied">Copy link</span>
							<span x-show="copied" x-cloak>Copied</span>
						</button>
					</div>
				</div>
			}

			<div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
				<div class="border-b border-slate-100 px-6 py-4">
					<h2 class="text-sm font-semibold text-slate-800">Invite a member</h2>
					<form method="post" action="/team/invite" class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
						<div>
							<label for="member-name" class="block text-xs font-medium text-slate-500">Full name</label>
							<input id="member-name" name="name" type="text" required
								class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500"/>
						</div>
						<div>
							<label for="member-email" class="block text-xs font-medium text-slate-500">Email</label>
							<input id="member-email" name="email" type="email" required
								class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500"/>
						</div>
						<div class="sm:col-span-2">
							<button type="submit"
								class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
								Send invitation
							</button>
						</div>
					</form>
				</div>

				<ul class="divide-y divide-slate-100">
					for _, m := range members {
						<li class="flex items-center justify-between gap-3 px-6 py-3">
							<div class="min-w-0">
								<p class="truncate text-sm font-medium text-slate-900">
									if m.Name != "" {
										{ m.Name }
									} else {
										{ m.Email }
									}
								</p>
								<p class="truncate text-xs text-slate-500">{ m.Email }</p>
							</div>
							<div class="flex shrink-0 items-center gap-2">
								<span class={ "rounded-full px-2 py-0.5 text-xs font-medium ", roleBadge(m.Role) }>{ m.Role }</span>
								if m.Pending {
									<span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">Pending</span>
								}
								if m.Role == "member" {
									<form method="post" action={ "/team/" + m.ID.String() + "/delete" }
										onsubmit="return confirm('Remove this member from the shop? They will lose access immediately.')">
										<button type="submit"
											class="rounded-lg border border-rose-200 px-2.5 py-1 text-xs font-medium text-rose-600 transition hover:bg-rose-50">
											Remove
										</button>
									</form>
								}
							</div>
						</li>
					}
				</ul>
			</div>
		</div>
	}
}

func inviteURL(base, token string) string {
	return base + "/invite/" + token
}

func roleBadge(role string) string {
	if role == "owner" {
		return "bg-indigo-100 text-indigo-700"
	}
	return "bg-slate-100 text-slate-600"
}